# Copy to .env. Required only for --live; offline replay needs no credentials.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=MINT

# Synchronous OpenRouter model IDs. Adjust to models available to your account.
# The archived paper runs used batch variants where recorded in inferred_contracts/*.csv.
MINT_GEMINI_MODEL=google/gemini-3.8-flash
MINT_SONNET_MODEL=anthropic/claude-sonnet-5.5
MINT_SOL_MODEL=openai/gpt-6.1-sol
MINT_NORMALIZER_MODEL=anthropic/claude-opus-5.5
MINT_QWEN_MODEL=qwen/qwen3.8-max-0902
MINT_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
MINT_MAX_OUTPUT_TOKENS=8000
MINT_REQUEST_TIMEOUT_SECONDS=300

# Optional: settings for the separate local Ollama inference CLI.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300
INFERRER_MAX_ATTEMPTS=3
